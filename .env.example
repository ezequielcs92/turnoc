# Valores públicos del proyecto enlazado. No uses la service-role key en Next.js.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical URL when the site is deployed. Local fallback: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Optional and explicit. Keep false when using a configured Supabase project.
NEXT_PUBLIC_USE_DEMO_CONTENT=false

# Cloudflare R2. Keep access credentials server-only. The public URL may be an
# r2.dev development URL temporarily; use a custom domain in production.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
NEXT_PUBLIC_R2_PUBLIC_URL=
