# Valores públicos del proyecto enlazado. No uses la service-role key en Next.js.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical URL when the site is deployed. Local fallback: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Optional and explicit. Keep false when using a configured Supabase project.
NEXT_PUBLIC_USE_DEMO_CONTENT=false
